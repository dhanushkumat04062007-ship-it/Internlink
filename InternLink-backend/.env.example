# Copy this file to InternLink-backend/.env and fill in your own values.
# Never commit the real .env file.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=InternLink

# Server
PORT=5000
# Allowed frontend origin(s), comma-separated. Leave empty to allow any origin.
CLIENT_URL=http://localhost:3000
